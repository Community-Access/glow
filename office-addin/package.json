{
  "name": "acb-large-print-addin",
  "version": "8.0.0",
  "description": "ACB Large Print Guidelines compliance add-in for Microsoft Word",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "webpack --mode production",
    "dev": "node scripts/dev.js",
    "start": "node scripts/dev.js --open",
    "dev:serve": "vite dist --config vite.config.mjs",
    "lint": "eslint src/**/*.ts",
    "sideload": "node scripts/sideload.js start",
    "unsideload": "node scripts/sideload.js stop",
    "cert:remove": "node scripts/remove-dev-ca.js"
  },
  "dependencies": {
    "@fluentui/web-components": "^2.6.1"
  },
  "overrides": {
    "@azure/monitor-opentelemetry": ">=1.18.0",
    "@opentelemetry/exporter-prometheus": ">=0.217.0",
    "@opentelemetry/sdk-node": ">=0.217.0",
    "express-rate-limit": ">=8.5.1",
    "fast-uri": ">=3.1.2",
    "fast-xml-builder": ">=1.1.7",
    "hono": ">=4.12.18",
    "ip-address": ">=10.1.1",
    "serialize-javascript": ">=7.0.5",
    "tmp": ">=0.2.4",
    "uuid": ">=14.0.0",
    "nanoid": "^3.3.18",
    "browserslist": "^4.28.7",
    "adm-zip": "^0.6.1"
  },
  "devDependencies": {
    "adm-zip": "^0.6.1",
    "@types/office-js": "^1.0.589",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.7",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^6.0.3",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-mkcert": "^2.1.0"
  }
}
