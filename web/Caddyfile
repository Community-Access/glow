# Caddyfile -- Production configuration
#
# This configures:
#   - csedesigns.com / www.csedesigns.com -- static site from ./www/
#   - letitglow.app -- canonical reverse proxy to Flask/Gunicorn
#   - lp.csedesigns.com + glow.bits-acb.org -- permanent redirect to letitglow.app

# Main website -- static files
csedesigns.com, www.csedesigns.com {
    root * /srv/www
    file_server
    encode gzip

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
    }
}

# Legacy app hostnames -> canonical hostname
lp.csedesigns.com, glow.bits-acb.org {
    # Keep existing GGG URLs stable for externally shared links.
    handle_path /ggg* {
        reverse_proxy ggg:80
    }

    redir https://letitglow.app{uri} 301
}

# ACB Large Print web application -- canonical reverse proxy to Flask/Gunicorn
letitglow.app {
    handle /auth* {
        reverse_proxy keycloak:8080
    }

    handle_path /mcp/* {
        reverse_proxy mcp:8000
    }

    handle_path /ggg* {
        reverse_proxy ggg:80
    }

    handle {
        reverse_proxy web:8000
        encode gzip

        header {
            X-Content-Type-Options nosniff
            X-Frame-Options DENY
            Referrer-Policy strict-origin-when-cross-origin
            Permissions-Policy "geolocation=(), microphone=(), camera=()"
            Content-Security-Policy "default-src 'none'; script-src 'self'; connect-src 'self'; style-src 'self'; img-src 'self'; media-src 'self' blob:; font-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'"
            Strict-Transport-Security "max-age=63072000; includeSubDomains"
        }
    }
}
