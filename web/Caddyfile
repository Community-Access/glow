# Caddyfile -- Production configuration
#
# This configures:
#   - csedesigns.com / www.csedesigns.com -- static site from ./www/
#   - letitglow.app -- canonical reverse proxy to Flask/Gunicorn
#   - lp.csedesigns.com + glow.bits-acb.org + www.letitglow.app -- permanent redirect to letitglow.app

# Main website -- static files
csedesigns.com, www.csedesigns.com {
    root * /srv/www
    file_server
    encode gzip

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
    }
}

# Legacy app hostnames -> canonical hostname
lp.csedesigns.com, glow.bits-acb.org, www.letitglow.app {
    # Keep existing GGG URLs stable for externally shared links.
    handle_path /ggg* {
        reverse_proxy ggg:80
    }

    redir https://letitglow.app{uri} 301
}

# ACB Large Print web application -- canonical reverse proxy to Flask/Gunicorn
letitglow.app {
    handle /auth* {
        reverse_proxy keycloak:8080
    }

    handle_path /mcp/* {
        reverse_proxy mcp:8000
    }

    handle_path /ggg* {
        reverse_proxy ggg:80
    }

    handle {
        reverse_proxy web:8000 {
            # Stream bytes to the client as soon as the upstream yields them.
            # Required so Server-Sent Events (job progress, AI playground,
            # speech, Ollama chat) reach the browser in real time instead of
            # being held back by Caddy's response buffer.
            flush_interval -1
        }

        # Gzip text-based responses only. text/event-stream is deliberately
        # excluded so SSE bytes are not buffered into a compression window.
        encode {
            gzip
            match {
                header Content-Type text/html*
                header Content-Type text/plain*
                header Content-Type text/css*
                header Content-Type text/xml*
                header Content-Type application/json*
                header Content-Type application/javascript*
                header Content-Type application/xml*
                header Content-Type image/svg+xml*
            }
        }

        header {
            X-Content-Type-Options nosniff
            X-Frame-Options DENY
            Referrer-Policy strict-origin-when-cross-origin
            Permissions-Policy "geolocation=(), microphone=(), camera=()"
            Content-Security-Policy "default-src 'none'; script-src 'self'; connect-src 'self'; style-src 'self'; img-src 'self'; media-src 'self' blob:; font-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'"
            Strict-Transport-Security "max-age=63072000; includeSubDomains"
        }
    }
}
