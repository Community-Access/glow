# Caddyfile -- Production configuration
#
# This configures:
#   - csedesigns.com / www.csedesigns.com -- static site from ./www/
#   - letitglow.app -- canonical reverse proxy to Flask/Gunicorn
#   - lp.csedesigns.com + glow.bits-acb.org + www.letitglow.app -- permanent redirect to letitglow.app

# Main website -- static files
csedesigns.com, www.csedesigns.com {
    root * /srv/www
    file_server
    encode gzip

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
    }
}

# Legacy app hostnames -> canonical hostname
lp.csedesigns.com, glow.bits-acb.org, www.letitglow.app {
    # Keep existing GGG URLs stable for externally shared links.
    handle_path /ggg* {
        reverse_proxy ggg:80
    }

    redir https://letitglow.app{uri} 301
}

# ACB Large Print web application -- canonical reverse proxy to Flask/Gunicorn
letitglow.app {
    handle /auth* {
        reverse_proxy keycloak:8080
    }

    handle_path /mcp/* {
        reverse_proxy mcp:8000
    }

    handle_path /ggg* {
        reverse_proxy ggg:80
    }

    # Server-Sent Events endpoints. Handled BEFORE the general handle{} so
    # the encode directive never sees these responses. The encode middleware
    # inspects each response chunk to decide whether to compress, and that
    # inspection buffers small SSE writes (heartbeats, progress deltas) until
    # the upstream closes. Splitting these paths into a dedicated handle keeps
    # the stream untouched between gunicorn and the browser.
    @sse path /job/*/status /playground/stream
    handle @sse {
        # Flask emits X-Content-Type-Options / X-Frame-Options / Referrer-Policy
        # per response; only transport-level HSTS is added here.
        header Strict-Transport-Security "max-age=63072000; includeSubDomains"
        reverse_proxy web:8000 {
            flush_interval -1
        }
    }

    handle {
        reverse_proxy web:8000 {
            flush_interval -1
        }

        # Gzip text-based responses only. text/event-stream is excluded both
        # by the allow-list below AND by the dedicated @sse handle above.
        encode {
            gzip
            match {
                header Content-Type text/html*
                header Content-Type text/plain*
                header Content-Type text/css*
                header Content-Type text/xml*
                header Content-Type application/json*
                header Content-Type application/javascript*
                header Content-Type application/xml*
                header Content-Type image/svg+xml*
            }
        }

        header {
            # Flask owns X-Content-Type-Options, X-Frame-Options, Referrer-Policy,
            # and the per-request Content-Security-Policy (with nonce). Caddy only
            # adds transport-level + policy headers that don't depend on app state.
            Permissions-Policy "geolocation=(), microphone=(), camera=()"
            Strict-Transport-Security "max-age=63072000; includeSubDomains"
        }
    }
}
