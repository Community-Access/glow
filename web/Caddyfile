# Caddyfile -- Production configuration
#
# This configures:
#   - csedesigns.com / www.csedesigns.com -- static site from ./www/
#   - letitglow.app -- canonical reverse proxy to Flask/Gunicorn
#   - lp.csedesigns.com + glow.bits-acb.org + www.letitglow.app -- permanent redirect to letitglow.app

# Main website -- static files
csedesigns.com, www.csedesigns.com {
    root * /srv/www
    file_server
    encode gzip

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
    }
}

# Legacy app hostnames -> canonical hostname
lp.csedesigns.com, glow.bits-acb.org, www.letitglow.app {
    # Keep existing GGG URLs stable for externally shared links.
    handle_path /ggg* {
        reverse_proxy ggg:80
    }

    # The Community Picks submission endpoint (feedback-hub 1.2.0), so that
    # quillforall.org/picks/suggest/ can file an issue for a visitor who has no
    # GitHub account. See ~/feedback-hub/deploy/README.md.
    #
    # ABOVE the redir below, like /ggg*, and for a sharper reason than tidiness:
    # a 301 here would send the browser to a different origin, the CORS check
    # would then be made against an origin the server does not allow, and the
    # form would fail in a way that looks exactly like the server being down.
    #
    # `handle`, not `handle_path`: handle_path strips the matched prefix, so
    # /submit/picks would reach the app as /picks and 404 against its own
    # configured PICKS_PATH.
    #
    # The matcher pins this to lp.csedesigns.com alone -- this site block covers
    # three hostnames and the endpoint has no business on the other two.
    @picks_submit {
        host lp.csedesigns.com
        path /submit/*
    }
    handle @picks_submit {
        reverse_proxy feedback-hub-submit:8095
    }

    # Clipman Server -- self-hosted encrypted clipboard sync (~/app/clipman).
    #
    # Pinned to lp.csedesigns.com for the same reason as @picks_submit above:
    # this site block covers three hostnames and a personal clipboard server
    # has no business on the other two.
    #
    # ABOVE the redir below, or every client request would 301 to letitglow.app.
    #
    # `uri strip_prefix` rather than `handle_path`: handle_path would do the
    # same stripping, but it only accepts an inline path matcher, and the host
    # pin above requires a named one. Clipman Server serves /api/v1/* and
    # /setup/* at its own root, so /clipman has to come off before the request
    # reaches it. Clients carry the prefix in their configured base address.
    @clipman {
        host lp.csedesigns.com
        path /clipman/*
    }
    handle @clipman {
        uri strip_prefix /clipman
        reverse_proxy clipman-server:8080
    }

    # QUILL testing downloads for the mailing list (2026-10-05): signed
    # installers and portables served from www/quill-testing, before they are
    # published on GitHub. ABOVE the redir below, or every request would 301
    # to letitglow.app. Pinned to lp.csedesigns.com like the blocks above.
    @quill_testing {
        host lp.csedesigns.com
        path /quill-testing /quill-testing/*
    }
    handle @quill_testing {
        root * /srv/www
        file_server
    }

    handle {
        redir https://letitglow.app{uri} 301
    }
}

# ACB Large Print web application -- canonical reverse proxy to Flask/Gunicorn
letitglow.app {
    handle /auth* {
        reverse_proxy keycloak:8080
    }

    handle_path /mcp/* {
        reverse_proxy mcp:8000
    }

    handle_path /ggg* {
        reverse_proxy ggg:80
    }

    # Server-Sent Events endpoints. Handled BEFORE the general handle{} so
    # the encode directive never sees these responses. The encode middleware
    # inspects each response chunk to decide whether to compress, and that
    # inspection buffers small SSE writes (heartbeats, progress deltas) until
    # the upstream closes. Splitting these paths into a dedicated handle keeps
    # the stream untouched between gunicorn and the browser.
    #
    # Both GLOW upstreams below dial the container name, not the service name
    # `web`. Other stacks on this host (quill-ai-gateway, askbits) also name a
    # service `web` and join web_default, so `web:8000` round-robined across
    # all three and about a third of GLOW requests got another app's 404 --
    # which left the consent page without consent.js and a Continue button
    # that never enabled (2026-10-09).
    @sse path /job/*/status /playground/stream
    handle @sse {
        # Flask emits X-Content-Type-Options / X-Frame-Options / Referrer-Policy
        # per response; only transport-level HSTS is added here.
        header Strict-Transport-Security "max-age=63072000; includeSubDomains"
        reverse_proxy web-web-1:8000 {
            flush_interval -1
        }
    }

    handle {
        reverse_proxy web-web-1:8000 {
            flush_interval -1
        }

        # Gzip text-based responses only. text/event-stream is excluded both
        # by the allow-list below AND by the dedicated @sse handle above.
        encode {
            gzip
            match {
                header Content-Type text/html*
                header Content-Type text/plain*
                header Content-Type text/css*
                header Content-Type text/xml*
                header Content-Type application/json*
                header Content-Type application/javascript*
                header Content-Type application/xml*
                header Content-Type image/svg+xml*
            }
        }

        header {
            # Flask owns X-Content-Type-Options, X-Frame-Options, Referrer-Policy,
            # and the per-request Content-Security-Policy (with nonce). Caddy only
            # adds transport-level + policy headers that don't depend on app state.
            Permissions-Policy "geolocation=(), microphone=(), camera=()"
            Strict-Transport-Security "max-age=63072000; includeSubDomains"
        }
    }
}

helpdesk.community-access.org {
	# Two upstreams behind one hostname: FreeScout for people, and the Postmark
	# bridge for the inbound webhook. The bridge is matched first; everything
	# else is FreeScout.

	# FreeScout sets its own Content-Security-Policy and cookie flags, so Caddy
	# adds only the transport-level and policy headers that do not depend on
	# application state.
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}

	# Attachments. FreeScout's own limit is set in its interface; this is the
	# proxy's, and the smaller of the two is the one that wins -- silently, and
	# with an error that blames the wrong component.
	request_body {
		max_size 25MB
	}

	# The Postmark inbound webhook, BEFORE the catch-all below -- otherwise it
	# reaches FreeScout, which 404s it, and Postmark spends ten retries over ten
	# and a half hours on a path that was never going to work.
	#
	# handle, not handle_path: the bridge answers on the full /postmark/inbound
	# and stripping the prefix would 404 it against its own configured path.
	#
	# The bridge does its own HTTP Basic check, so Caddy passes the header
	# straight through and adds no auth of its own -- two places to configure a
	# credential is one too many, and the one that matters is the one the
	# request is actually validated against.
	@postmark path /postmark/*
	handle @postmark {
		reverse_proxy helpdesk-mailbridge:8096
	}

	# FreeScout gets everything else -- and it is inside a `handle` rather than
	# left as a bare reverse_proxy on purpose. Caddy sorts directives by a fixed
	# order, so a bare directive alongside a handle block is evaluated at its
	# own position in that order rather than where it appears in the file.
	# Writing both as handles makes them mutually exclusive and makes the order
	# on the page the order that runs. The `lp.csedesigns.com` block on this
	# same box had a bare `redir` that silently shadowed every handler above it
	# for months; this is that lesson, applied before it costs anything.
	handle {
		reverse_proxy helpdesk-app:80 {
			# Without X-Forwarded-Proto, FreeScout builds every absolute URL as
			# http:// -- so the login POST leaves an https page for an http one,
			# the browser refuses it as mixed content, and sign-in fails with
			# nothing in any log that names the cause. Caddy sets this by
			# default; it is written out because the container is configured to
			# trust it (ENABLE_SSL_PROXY=TRUE) and the two have to agree.
			header_up X-Forwarded-Proto {scheme}

			# Long enough for a mailbox fetch or a module install to finish.
			# A deliberate ceiling, so a wedged request cannot hold a
			# connection open forever.
			transport http {
				response_header_timeout 120s
			}
		}
	}

	encode {
		gzip
		match {
			header Content-Type text/html*
			header Content-Type text/plain*
			header Content-Type text/css*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type image/svg+xml*
		}
	}

	log {
		output file /data/helpdesk-access.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}

# Caddy site block for the QUILL AI Gateway.
#
# Append this to the Caddyfile the shared host already uses --
# on lp.csedesigns.com ("bishoplink") that is /home/jeffbis/app/web/Caddyfile,
# mounted into the `web-caddy-1` container -- then reload:
#
#     docker exec web-caddy-1 caddy reload --config /etc/caddy/Caddyfile
#
# Do not reload until the DNS record resolves. Caddy asks Let's Encrypt for a
# certificate the moment the block loads, and a name that does not yet point at
# this machine fails that challenge, backs off, and retries on a lengthening
# timer -- so the site stays broken for a while after DNS is fixed.
#
# ---------------------------------------------------------------------------
# A SUBDOMAIN OF ITS OWN, NOT A PATH UNDER lp.csedesigns.com
# ---------------------------------------------------------------------------
# lp.csedesigns.com is already a permanent-redirect block pointing at
# letitglow.app, with a couple of path matchers pinned inside it for the
# feedback and picks endpoints. Hanging an API off another path in there means
# every new route has to out-rank a `redir` that matches everything -- which is
# exactly the trap that cost an afternoon when the picks endpoint went in. A
# separate name has no ordering to reason about, gets its own certificate, and
# can be moved to another machine later by changing one DNS record.

ai.community-access.org {
    encode gzip

    # `quill-ai-gateway-web-1` is the container name docker compose gives the
    # `web` service under the project name set in docker-compose.prod.yml.
    # Caddy resolves it over the shared `web_default` network, the same way it
    # already reaches askbits-web.
    reverse_proxy quill-ai-gateway-web-1:8000

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
        # The dashboard's session cookie is already Secure, HttpOnly and
        # SameSite=Lax (app/config.py). HSTS is the additional, server-level
        # guarantee that a browser never even attempts plain HTTP -- which
        # matters here because the thing being carried is a bearer token.
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }

    # The sign-up throttle in app/limits.py counts per client address, and it
    # reads X-Forwarded-For. That header is only trustworthy because this block
    # is the sole route in: Caddy overwrites it with the real peer. If the
    # container is ever published on a host port as well, the header becomes
    # attacker-controlled and the throttle becomes decorative.

    log {
        output file /var/log/caddy/quill-ai-gateway.log {
            roll_size 10MiB
            roll_keep 5
        }
        # Bearer tokens travel in the Authorization header and device codes in
        # request bodies. Neither is logged by Caddy's default common_log
        # format, and neither should be added to it.
        format console
    }
}
